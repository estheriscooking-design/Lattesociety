# Copier en .env.local (en local) ou saisir dans Vercel (en ligne).

# Code d'accès à l'écran d'Esther (/esther). Obligatoire.
ESTHER_CODE=

# FedaPay. Sans clé, le site est en mode démonstration : le paiement est simulé.
# Clé secrète du compte marchand d'Esther : sk_sandbox_... pour les essais, sk_live_... pour de vrai.
FEDAPAY_SECRET_KEY=

# Supabase, obligatoire en ligne (sur Vercel le disque ne garde rien). Voir supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Alerte à chaque commande payée (facultatif, un canal ou les deux).
# Telegram : créer un bot avec @BotFather, lui écrire une fois, puis renseigner :
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# E-mail par Resend :
RESEND_API_KEY=
ALERTE_EMAIL=
ALERTE_EXPEDITEUR=
# Adresse du site en ligne, pour le lien vers l'écran d'Esther dans l'alerte :
SITE_URL=
